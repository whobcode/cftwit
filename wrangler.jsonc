{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cftwit",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "cftwit.hwmnbn.me", "custom_domain": true }],
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    // /__scheduled lets `wrangler dev --test-scheduled` trigger the cron locally; it 404s in production.
    "run_worker_first": ["/api/*", "/media/*", "/__scheduled"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cftwit",
      "database_id": "1491901a-e139-40bf-857e-99b9d0611c16",
      "migrations_dir": "migrations"
    },
    // Read-only sources for src/sync.ts. No migrations_dir: cftwit must never migrate these.
    { "binding": "HUES_DB", "database_name": "hue_green_db", "database_id": "42c1a01b-3a92-445e-b7d2-2fedc5ee0060" },
    { "binding": "SHADE_DB", "database_name": "social_rpg_db", "database_id": "fa8ff2b3-6fc2-4ae7-bcd9-eaf5bb2ef6e6" }
  ],
  // Every 5 minutes, never on :00/:15/:30/:45 when shade's own cron loads social_rpg_db.
  // src/index.ts runs the member sync at :07/:22/:37/:52 and news at :02/:17/:32/:47; bots every tick.
  "triggers": { "crons": ["2-59/5 * * * *"] },
  "ai": { "binding": "AI" },
  // Cloudflare Email Sending. MAIL_FROM's domain must be onboarded under Email > Email Sending.
  "send_email": [{ "name": "EMAIL" }],
  "vars": { "MAIL_FROM": "cftwit@hwmnbn.me" },
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "cftwit-media" }],
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "WRITE_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
